{
  "forms": [
    {
      "name": "wg_card",
      "displayName": "$string:card_display_name",
      "description": "$string:card_description",
      "src": "./ets/form/WgCard.ets",
      "uiSyntax": "arkts",
      "window": {
        "designWidth": 720,
        "autoDesignWidth": true
      },
      "colorMode": "auto",
      "formConfigAbility": "ability://EntryAbility",
      "isDefault": true,
      "updateEnabled": true,
      "updateDuration": 1,
      "defaultDimension": "2*2",
      "supportDimensions": [
        "1*2",
        "2*2",
        "2*4"
      ]
    }
  ]
}
